# Reference clones — upstream source we read, never commit (328MB of third-party code)
/reference/

# Brainstorming visual-companion artifacts
/.superpowers/

# Git worktrees (isolated workspaces for feature branches)
/.worktrees/

# macOS
.DS_Store

# Secrets / credentials — never commit API keys or OAuth tokens
secrets.yaml
.env
.env.*
*.key
*-credentials.json
credentials.json
token.json

# Node (for any custom Lovelace card build tooling)
node_modules/
dist/
*.log

# Grocy container runtime state (SQLite db + uploads) — created by the compose
# bind-mount in deploy/grocy/, never committed
deploy/grocy/grocy-config/

# Dev-HA container config dir — assembled by deploy/homeassistant/dev-setup.sh.
# Holds generated copies of the committed packages, the built card modules, the
# HA database, and secrets.yaml. All generated; none of it is committed.
deploy/homeassistant/dev-config/

# Python (for any custom_components dev)
__pycache__/
*.pyc
.venv/
venv/

# Stray subagent tooling artifact (match at any depth, not just repo root)
.claude-flow/

# Playwright MCP scratch dir (browser-verification console/page dumps)
.playwright-mcp/

.superpowers/

# Vendored reference collections (design link lists), cloned 2026-09-01. Not ours.
git/
